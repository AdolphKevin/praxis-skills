  "acceptance_entries": {
    "cli": {
      "surface": "cli",
      "operate": "在未接入 tw 的临时 Git 仓库中，用 python3 运行候选版 sop-verify/scripts/sop.py 的子命令",
      "observe": [
        "标准输出",
        "错误输出",
        "退出码",
        "仓库内文件变化",
        "本机状态目录中的文件变化"
